# Supabase — frontend (apenas leitura/RLS)
# Crie um .env.local a partir deste arquivo e preencha os valores.
# Nunca commite o .env.local.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_sua_chave_publica_aqui

# Supabase — service role (apenas backend/edge functions)
# NUNCA coloque esta key em variáveis VITE_ ou no código do cliente.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_sua_chave_secreta_aqui
# PostgreSQL direct connection (apenas scripts locais)
DATABASE_URL=postgresql://postgres:[SENHA]@db.[projeto].supabase.co:5432/postgres
# Sentry — monitoramento de erros (opcional)
VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
